{
  "name": "flyt",
  "productName": "Flyt",
  "version": "0.1.0",
  "description": "Forgiving, bilingual (English/Norwegian) voice dictation for your whole desktop. A Wispr Flow replacement.",
  "main": "dist/main/main/index.js",
  "private": true,
  "license": "MIT",
  "author": "Morten Nilsen",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "uiohook-napi": "^1.5.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "npm run build:main && npm run build:renderer && npm run icon",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "icon": "node scripts/make-icon.mjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json",
    "test": "vitest run",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  }
}
